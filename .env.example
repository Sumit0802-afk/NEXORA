# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
APP_ENV=development
API_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://houseplan:houseplan_dev@localhost:5432/houseplan
REDIS_URL=redis://localhost:6379/0
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email (see docs/EMAIL.md). Values come from your email provider; never commit real ones.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender on YOUR verified domain. Shown to recipients as "NEXORA <noreply@yourdomain.com>".
MAIL_FROM_ADDRESS=noreply@yourdomain.com
# Private inbox that receives feedback / contact / support messages. Stays on the server.
SUPPORT_INBOX=
# Public URL of the web app's /email folder, for the optional glow pictures in the OTP email.
EMAIL_ASSET_BASE_URL=
